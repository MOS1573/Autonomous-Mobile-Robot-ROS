<?xml version="1.0"?>
<!-- Mecanum-wheel AMR. Frames follow REP 105: base_footprint -> base_link -> sensors. -->
<robot name="amr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Dimensions (m). Keep wheel values in sync with firmware/amr_base_teensy/config.h -->
  <xacro:property name="body_length"  value="0.46"/>
  <xacro:property name="body_width"   value="0.32"/>
  <xacro:property name="body_height"  value="0.15"/>
  <xacro:property name="wheel_radius" value="0.098"/>
  <xacro:property name="wheel_width"  value="0.028"/>
  <xacro:property name="wheel_base_x" value="0.300"/>
  <xacro:property name="wheel_base_y" value="0.360"/>

  <material name="black"><color rgba="0.10 0.10 0.10 1"/></material>
  <material name="yellow"><color rgba="0.95 0.85 0.20 1"/></material>
  <material name="grey"><color rgba="0.50 0.50 0.50 1"/></material>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="mecanum_wheel" params="name x y">
    <link name="${name}_wheel_link">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="yellow"/>
      </visual>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:mecanum_wheel name="front_left"  x="${ wheel_base_x/2}" y="${ wheel_base_y/2}"/>
  <xacro:mecanum_wheel name="front_right" x="${ wheel_base_x/2}" y="${-wheel_base_y/2}"/>
  <xacro:mecanum_wheel name="rear_left"   x="${-wheel_base_x/2}" y="${ wheel_base_y/2}"/>
  <xacro:mecanum_wheel name="rear_right"  x="${-wheel_base_x/2}" y="${-wheel_base_y/2}"/>

  <!-- RPLIDAR A1 on top of the body -->
  <link name="laser">
    <visual>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="grey"/>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.12 0 ${body_height/2 + 0.03}" rpy="0 0 ${pi}"/>
  </joint>

  <!-- MPU6050 next to the Teensy -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

</robot>
